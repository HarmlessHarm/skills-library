---
import type { Tag } from '../lib/items';

interface Props {
  tags: (Tag & { count: number })[];
  /** How many items live in this library and how many are external picks. */
  origins: { library: number; external: number };
}

const { tags, origins } = Astro.props;

// Only worth offering when there is something on both sides.
const originFilters =
  origins.library > 0 && origins.external > 0
    ? [
        { id: '', label: 'All', count: origins.library + origins.external },
        { id: 'library', label: 'Ours', count: origins.library },
        { id: 'external', label: 'External', count: origins.external },
      ]
    : [];
---

<div class="wrap filters">
  <div class="filters__search">
    <label class="visually-hidden" for="search">Search skills</label>
    <input id="search" type="search" placeholder="Search by name or tag…" autocomplete="off" />
    <kbd class="filters__shortcut">/</kbd>
  </div>

  {
    tags.length > 0 && (
      <div class="filters__tags chips" role="group" aria-label="Filter by tag">
        {tags.map((tag) => (
          <button class="chip" type="button" data-tag-filter={tag.id} aria-pressed="false">
            {tag.label}
            <span class="chip__count">{tag.count}</span>
          </button>
        ))}
      </div>
    )
  }

  <p class="filters__status">
    {
      originFilters.length > 0 && (
        <span class="chips" role="group" aria-label="Filter by origin">
          {originFilters.map((o) => (
            <button class="chip" type="button" data-origin-filter={o.id} aria-pressed={String(o.id === '')}>
              {o.label}
              <span class="chip__count">{o.count}</span>
            </button>
          ))}
        </span>
      )
    }
    <span id="result-count" aria-live="polite"></span>
    <button class="filters__reset" type="button" id="reset-filters" hidden>Clear filters</button>
  </p>
</div>
