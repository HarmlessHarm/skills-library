---
import type { Tag } from '../lib/items';

interface Props {
  tags: (Tag & { count: number })[];
}

const { tags } = Astro.props;
---

<div class="wrap filters">
  <div class="filters__search">
    <label class="visually-hidden" for="search">Search skills and commands</label>
    <input id="search" type="search" placeholder="Search by name or tag…" autocomplete="off" />
    <kbd class="filters__shortcut">/</kbd>
  </div>

  {
    tags.length > 0 && (
      <div class="filters__tags chips" role="group" aria-label="Filter by tag">
        {tags.map((tag) => (
          <button class="chip" type="button" data-tag-filter={tag.id} aria-pressed="false">
            {tag.label}
            <span class="chip__count">{tag.count}</span>
          </button>
        ))}
      </div>
    )
  }

  <p class="filters__status">
    <span id="result-count" aria-live="polite"></span>
    <button class="filters__reset" type="button" id="reset-filters" hidden>Clear filters</button>
  </p>
</div>
