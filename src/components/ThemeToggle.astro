---
// Three-state theme control. "System" is the default and is represented by the
// absence of a data-theme attribute, so the CSS in theme.css falls back to
// `color-scheme: light dark` and the page follows the OS setting.
const options = [
  { id: 'system', label: 'System' },
  { id: 'light', label: 'Light' },
  { id: 'dark', label: 'Dark' },
];
---

<div class="theme-toggle" role="group" aria-label="Colour theme">
  {
    options.map((option) => (
      <button
        class="theme-toggle__button"
        type="button"
        data-theme-choice={option.id}
        aria-label={option.label}
        title={option.label}
        aria-pressed={option.id === 'system'}
      >
        {option.id === 'system' && (
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <rect x="3" y="4" width="18" height="12" rx="2" />
            <path d="M9 20h6M12 16v4" />
          </svg>
        )}
        {option.id === 'light' && (
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
          </svg>
        )}
        {option.id === 'dark' && (
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20 13.5A8 8 0 1 1 10.5 4a6.5 6.5 0 0 0 9.5 9.5z" />
          </svg>
        )}
      </button>
    ))
  }
</div>

<script>
  const STORE_KEY = 'theme';
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-theme-choice]');

  function paint(choice: string) {
    for (const button of buttons) {
      button.setAttribute('aria-pressed', String(button.dataset.themeChoice === choice));
    }
  }

  function read(): string {
    try {
      const stored = localStorage.getItem(STORE_KEY);
      return stored === 'light' || stored === 'dark' ? stored : 'system';
    } catch {
      return 'system';
    }
  }

  // The <head> script already applied the stored choice; mirror it in the
  // control so the pressed state agrees with what is on screen.
  paint(read());

  for (const button of buttons) {
    button.addEventListener('click', () => {
      const choice = button.dataset.themeChoice ?? 'system';

      if (choice === 'system') delete document.documentElement.dataset.theme;
      else document.documentElement.dataset.theme = choice;

      try {
        if (choice === 'system') localStorage.removeItem(STORE_KEY);
        else localStorage.setItem(STORE_KEY, choice);
      } catch {
        // Private browsing — the choice just will not persist.
      }

      paint(choice);
    });
  }
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    gap: 2px;
    padding: 2px;
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
  }

  .theme-toggle__button {
    display: grid;
    place-items: center;
    width: 26px;
    height: 24px;
    padding: 0;
    color: var(--text-faint);
    background: none;
    border: 0;
    border-radius: var(--radius-pill);
    cursor: pointer;
  }

  .theme-toggle__button:hover {
    color: var(--text);
  }

  .theme-toggle__button[aria-pressed='true'] {
    color: var(--accent);
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .theme-toggle__button svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
