---
import { config } from '../lib/config';
import { withBase } from '../lib/url';
import AgentSelect from './AgentSelect.astro';
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  /** Which nav item gets the brand-coloured "you are here" underline. */
  section?: 'skills' | 'blog';
}

const { section } = Astro.props;

const nav = [
  { id: 'skills', label: 'Skills', href: withBase('/') },
  { id: 'blog', label: 'Blog', href: withBase('/blog/') },
  { id: 'contribute', label: 'Contribute', href: withBase('/#contribute') },
];
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="site-header__brand" href={withBase('/')} aria-label={`${config.site.title}, home`}>
      <Logo />
      <span class="site-header__title">{config.site.title}</span>
    </a>

    <nav class="site-nav" aria-label="Main">
      {
        nav.map((item) => (
          <a class="site-nav__link" href={item.href} aria-current={item.id === section ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="site-header__tools">
      <AgentSelect />
      <ThemeToggle />
    </div>
  </div>
</header>
