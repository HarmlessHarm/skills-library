---
import { render } from 'astro:content';
import type { Skill } from '../lib/items';
import { withBase } from '../lib/url';
import PostsPanel from './PostsPanel.astro';
import InstallPanel from './InstallPanel.astro';

interface Props {
  item: Skill;
}

const { item } = Astro.props;
const { Content } = await render(item.entry);
---

<div class="wrap">
  <p class="breadcrumb">
    <a href={withBase('/')}>Home</a> / Skills
  </p>

  <div class="detail">
    <article>
      <h1 class="detail__title">{item.title}</h1>
      <p class="detail__desc">{item.description}</p>

      <div class="detail__badges">
        {item.tags.map((tag) => (
          <a class="badge" href={withBase(`/?tag=${encodeURIComponent(tag.id)}`)}>
            {tag.label}
          </a>
        ))}
      </div>

      <div class="prose">
        <Content />
      </div>
    </article>

    <aside class="detail__aside">
      <InstallPanel name={item.slug} />

      <section class="panel">
        <h2>Details</h2>
        <dl class="meta-list">
          <div><dt>Name</dt><dd><code>{item.name}</code></dd></div>
          <div><dt>Version</dt><dd>{item.version}</dd></div>
          {item.author && <div><dt>Author</dt><dd>{item.author}</dd></div>}
          {item.license && <div><dt>License</dt><dd>{item.license}</dd></div>}
          {item.homepage && <div><dt>Homepage</dt><dd><a href={item.homepage} target="_blank" rel="noopener">Link</a></dd></div>}
        </dl>
      </section>
      <PostsPanel slug={item.slug} />
    </aside>
  </div>
</div>

