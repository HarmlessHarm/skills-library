---
import { skillSnippets, downloadUrl, sourceUrl } from '../lib/install';
import Terminal from './Terminal.astro';

interface Props {
  name: string;
}

const { name } = Astro.props;
const snippets = skillSnippets(name);
---

<section class="panel">
  <h2>Install</h2>

  {
    snippets.map(({ agent, script }) => (
      <div class="agent-block" data-agent-id={agent.id}>
        <Terminal script={script} />
        <p class="panel__note">
          <span>
            Installs into the current project. Add <code>-g</code> to install it for all your
            projects.
          </span>
          {agent.docs && (
            <a href={agent.docs} target="_blank" rel="noopener">
              {agent.label} docs →
            </a>
          )}
        </p>
      </div>
    ))
  }
</section>

<section class="panel">
  <h2>Download</h2>
  <a class="button" href={downloadUrl(name)} download>Download {name}.skill</a>
  <a class="button button--secondary" href={sourceUrl(name)} target="_blank" rel="noopener">View source on GitHub</a>
  <p class="panel__note">
    A zip archive of the skill folder — SKILL.md plus any supporting files — for installing by
    hand.
  </p>
</section>
