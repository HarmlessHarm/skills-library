---
// The header logo. With `site.logo` set in config.yaml it shows that image
// (a path inside public/); otherwise the built-in mark: a spark on a rounded
// tile, filled with the theme's brand colour so it follows `theme.brand`.
import { config } from '../lib/config';
import { withBase } from '../lib/url';

const logo = config.site.logo;
---

{
  logo ? (
    <img class="logo logo--image" src={withBase(logo)} alt="" height="40" />
  ) : (
    <svg class="logo" width="40" height="40" viewBox="0 0 40 40" aria-hidden="true">
      <rect class="logo__tile" width="40" height="40" rx="11" />
      <path
        class="logo__spark"
        d="M20 7c1 8.6 4.4 12 13 13-8.6 1-12 4.4-13 13-1-8.6-4.4-12-13-13 8.6-1 12-4.4 13-13z"
      />
    </svg>
  )
}

<style>
  .logo {
    flex: none;
    display: block;
  }

  .logo--image {
    width: auto;
  }

  .logo__tile {
    fill: var(--brand);
  }

  .logo__spark {
    fill: var(--brand-contrast);
  }
</style>
