---
// Gemeente Amsterdam word mark: the three St Andrew's crosses with the name
// beside them. Drawn by hand for now. Swap for the official SVG before this
// goes public.
---

<span class="logo">
  <svg class="logo__crosses" width="18" height="56" viewBox="0 0 18 56" aria-hidden="true">
    <path d="M2 2 L16 16 M16 2 L2 16"></path>
    <path d="M2 20 L16 34 M16 20 L2 34"></path>
    <path d="M2 38 L16 52 M16 38 L2 52"></path>
  </svg>
  <span class="logo__name"><span>Gemeente</span><span>Amsterdam</span></span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--brand-red);
  }

  .logo__crosses {
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 4.2;
  }

  .logo__name {
    display: flex;
    flex-direction: column;
    font-weight: 700;
    font-size: 17px;
    line-height: 20px;
  }
</style>
