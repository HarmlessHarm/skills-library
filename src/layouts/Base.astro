---
import { config, defaultAgent, repo } from '../lib/config';
import { withBase } from '../lib/url';
import Header from '../components/Header.astro';
import '../styles/theme.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Highlights the matching nav item in the header. */
  section?: 'skills' | 'blog';
}

const { title, description = config.site.description, section } = Astro.props;
const pageTitle = title ? `${title} · ${config.site.title}` : config.site.title;

// One visibility rule per agent, plus a no-JS fallback to the default agent.
const agentRules = [
  ...config.agents.map(
    (agent) => `html[data-agent="${agent.id}"] .agent-block[data-agent-id="${agent.id}"] { display: var(--agent-display, block); }`,
  ),
  `html:not([data-agent]) .agent-block[data-agent-id="${defaultAgent.id}"] { display: var(--agent-display, block); }`,
].join('\n');

const agentIds = config.agents.map((a) => a.id);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <style set:html={agentRules} />
    <script is:inline define:vars={{ agentIds, fallback: defaultAgent.id }}>
      // Runs before first paint, so the correct install snippet is the only one
      // ever painted and the theme never flashes.
      try {
        const agent = localStorage.getItem('agent');
        document.documentElement.dataset.agent = agentIds.includes(agent) ? agent : fallback;
      } catch {
        document.documentElement.dataset.agent = fallback;
      }

      try {
        const theme = localStorage.getItem('theme');
        // Anything else — including "system" — leaves the attribute off, which
        // is what makes theme.css fall through to the OS setting.
        if (theme === 'light' || theme === 'dark') {
          document.documentElement.dataset.theme = theme;
        }
      } catch {
        /* Private browsing — fall through to the system setting. */
      }
    </script>
  </head>

  <body>
    <Header section={section} />

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap site-footer__inner">
        <span>Gemeente Amsterdam · {config.site.title}</span>
        <span class="site-footer__links">
          <a href={repo.url} rel="noopener">GitHub repository</a>
          <a href="https://agentskills.io" rel="noopener">Agent Skills format</a>
          <span>Built with <a href="https://astro.build" rel="noopener">Astro</a></span>
        </span>
      </div>
    </footer>
  </body>
</html>
