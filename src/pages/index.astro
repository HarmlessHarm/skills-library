---
import Base from '../layouts/Base.astro';
import Filters from '../components/Filters.astro';
import Icon from '../components/Icon.astro';
import LatestPost from '../components/LatestPost.astro';
import SkillCard from '../components/SkillCard.astro';
import { config, repo } from '../lib/config';
import { getItems, usedKinds, usedTags } from '../lib/items';
import { getPosts } from '../lib/posts';

const items = await getItems();
const posts = await getPosts();
const tags = usedTags(items);
const kinds = usedKinds(items);
const origins = {
  library: items.filter((i) => i.origin === 'library').length,
  external: items.filter((i) => i.origin === 'external').length,
};

// Newest post per item, for the "Read: …" link on its card. Posts are sorted
// newest first, so the first one seen for an item wins.
const postFor = new Map<string, (typeof posts)[number]>();
for (const post of posts) {
  for (const item of post.items) if (!postFor.has(item.slug)) postFor.set(item.slug, post);
}

const latest = posts[0];
const docs = (anchor: string) => `${repo.url}#${anchor}`;
---

<Base section="skills">
  <section class="hero">
    <div class="wrap hero__inner">
      <div class="hero__intro">
        <div class="hero__text">
          <h1>{config.site.tagline}</h1>
          <p class="hero__lead">{config.site.description}</p>
        </div>

        <div class="search" role="search">
          <label class="search__label" for="search">Search the library</label>
          <div class="search__field">
            <Icon name="search" size={20} />
            <input id="search" type="search" placeholder="Name, description or tag" autocomplete="off" />
            <kbd class="search__shortcut" aria-hidden="true">/</kbd>
          </div>
        </div>
      </div>

      {latest && <LatestPost post={latest} />}
    </div>
  </section>

  <section class="wrap library" aria-labelledby="library-title">
    <Filters tags={tags} kinds={kinds} origins={origins} />

    <ul class="grid" id="grid">
      {items.map((item) => <SkillCard item={item} post={postFor.get(item.slug)} />)}
    </ul>
    <p class="empty" id="empty" hidden>Nothing matches that search.</p>
  </section>

  <section id="contribute" class="wrap contribute" aria-labelledby="contribute-title">
    <div class="contribute__box">
      <div class="contribute__col">
        <h2 id="contribute-title">Contribute</h2>
        <p>Everything here is a file in the repository. Open a pull request and the site rebuilds on merge.</p>
      </div>
      <div class="contribute__col">
        <h3>Share a skill</h3>
        <p>
          Add <code>skills/&lt;name&gt;/SKILL.md</code>, or describe something from another project in
          <code>external/&lt;name&gt;.md</code>.
        </p>
        <a href={docs('adding-a-skill')}>How to add a skill</a>
      </div>
      <div class="contribute__col">
        <h3>Share your experience</h3>
        <p>Write a short post in <code>posts/</code> about a skill or framework you used: what worked, what didn't.</p>
        <a href={docs('writing-a-post')}>How to write a post</a>
      </div>
    </div>
  </section>
</Base>

<script>
  // Filtering happens entirely in the DOM over pre-rendered cards: no index to
  // ship, no data to fetch, and the page works without JavaScript.
  const search = document.querySelector<HTMLInputElement>('#search');
  const grid = document.querySelector<HTMLElement>('#grid');
  const empty = document.querySelector<HTMLElement>('#empty');
  const count = document.querySelector<HTMLElement>('#result-count');
  const reset = document.querySelector<HTMLButtonElement>('#reset-filters');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-item]'));

  const state = { q: '', tag: '', kind: '', origin: '' };

  function press(attr: string, value: string) {
    for (const button of document.querySelectorAll<HTMLElement>(`[data-${attr}-filter]`)) {
      button.setAttribute('aria-pressed', String(button.getAttribute(`data-${attr}-filter`) === value));
    }
  }

  function matches(card: HTMLElement) {
    if (state.origin && card.dataset.origin !== state.origin) return false;
    if (state.kind && card.dataset.kind !== state.kind) return false;
    if (state.tag && !(card.dataset.tags ?? '').split(',').includes(state.tag)) return false;
    if (state.q && !(card.dataset.search ?? '').includes(state.q)) return false;
    return true;
  }

  function apply(pushUrl = true) {
    let visible = 0;

    for (const card of cards) {
      const show = matches(card);
      (card.parentElement as HTMLElement).hidden = !show;
      if (show) visible++;
    }

    empty!.hidden = visible > 0;
    grid!.hidden = visible === 0;
    count!.textContent = `${visible} of ${cards.length} shown`;

    reset!.hidden = !(state.q || state.tag || state.kind || state.origin);

    if (pushUrl) {
      const params = new URLSearchParams();
      if (state.q) params.set('q', state.q);
      if (state.tag) params.set('tag', state.tag);
      if (state.kind) params.set('type', state.kind);
      if (state.origin) params.set('from', state.origin);
      const query = params.toString();
      history.replaceState(null, '', query ? `?${query}` : location.pathname);
    }
  }

  // Restore a shared/bookmarked filtered view.
  const params = new URLSearchParams(location.search);
  state.q = (params.get('q') ?? '').toLowerCase();
  state.tag = (params.get('tag') ?? '').toLowerCase();
  state.kind = (params.get('type') ?? '').toLowerCase();
  state.origin = ['library', 'external'].includes(params.get('from') ?? '') ? params.get('from')! : '';
  if (search) search.value = params.get('q') ?? '';
  press('tag', state.tag);
  press('kind', state.kind);
  press('origin', state.origin);

  let timer: ReturnType<typeof setTimeout>;
  search?.addEventListener('input', () => {
    clearTimeout(timer);
    timer = setTimeout(() => {
      state.q = search.value.trim().toLowerCase();
      apply();
    }, 120);
  });

  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement | null;

    const origin = target?.closest<HTMLElement>('[data-origin-filter]');
    if (origin) {
      state.origin = origin.dataset.originFilter ?? '';
      press('origin', state.origin);
      apply();
      return;
    }

    // Type and tag chips toggle, so clicking the active one clears it.
    const kind = target?.closest<HTMLElement>('[data-kind-filter]');
    if (kind) {
      state.kind = state.kind === kind.dataset.kindFilter ? '' : (kind.dataset.kindFilter ?? '');
      press('kind', state.kind);
      apply();
      return;
    }

    const chip = target?.closest<HTMLElement>('[data-tag-filter]');
    if (!chip) return;
    state.tag = state.tag === chip.dataset.tagFilter ? '' : (chip.dataset.tagFilter ?? '');
    press('tag', state.tag);
    apply();
  });

  reset?.addEventListener('click', () => {
    Object.assign(state, { q: '', tag: '', kind: '', origin: '' });
    if (search) search.value = '';
    press('tag', '');
    press('kind', '');
    press('origin', '');
    apply();
  });

  document.addEventListener('keydown', (event) => {
    const typingElsewhere =
      document.activeElement instanceof HTMLInputElement || document.activeElement instanceof HTMLSelectElement;
    if (event.key === '/' && !typingElsewhere) {
      event.preventDefault();
      search?.focus();
    }
    if (event.key === 'Escape' && document.activeElement === search) {
      search?.blur();
    }
  });

  apply(false);
</script>
