---
import Base from '../layouts/Base.astro';
import Filters from '../components/Filters.astro';
import SkillCard from '../components/SkillCard.astro';
import Terminal from '../components/Terminal.astro';
import { config, maintainer } from '../lib/config';
import { librarySnippets } from '../lib/install';
import { getItems, usedTags } from '../lib/items';

const items = await getItems();
const tags = usedTags(items);
const origins = {
  library: items.filter((i) => i.origin === 'library').length,
  external: items.filter((i) => i.origin === 'external').length,
};

const library = librarySnippets();

const counts = [
  `${origins.library} skill${origins.library === 1 ? '' : 's'}`,
  origins.external > 0 && `${origins.external} external pick${origins.external === 1 ? '' : 's'}`,
]
  .filter(Boolean)
  .join(' · ');
---

<Base>
  <section class="hero">
    <div class="wrap">
      <h1>{config.site.title}</h1>
      <p class="hero__tagline">{config.site.tagline}</p>

      <div class="hero__install">
        {
          library.map(({ agent, script }) => (
            <div class="agent-block" data-agent-id={agent.id}>
              <p class="hero__install-label">Add every skill in this library to {agent.label}</p>
              <Terminal script={script} />
              <p class="hero__install-note">
                Installs into the current project — add <code>-g</code> for all your projects. Open
                any skill below to install just that one.
              </p>
            </div>
          ))
        }
      </div>

      <p class="hero__meta">
        <span>{counts}</span>
        {
          maintainer.name && (
            <span>
              {' · maintained by '}
              {maintainer.url ? (
                <a href={maintainer.url} rel="noopener">
                  {maintainer.name}
                </a>
              ) : (
                maintainer.name
              )}
            </span>
          )
        }
      </p>
    </div>
  </section>

  <Filters tags={tags} origins={origins} />

  <div class="wrap">
    <ul class="grid" id="grid">
      {items.map((item) => <SkillCard item={item} />)}
    </ul>
    <p class="empty" id="empty" hidden>No skills match that search.</p>
  </div>
</Base>

<script>
  // Filtering happens entirely in the DOM over pre-rendered cards: no index to
  // ship, no data to fetch, and the page works without JavaScript.
  const search = document.querySelector<HTMLInputElement>('#search');
  const grid = document.querySelector<HTMLElement>('#grid');
  const empty = document.querySelector<HTMLElement>('#empty');
  const count = document.querySelector<HTMLElement>('#result-count');
  const reset = document.querySelector<HTMLButtonElement>('#reset-filters');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-item]'));

  const state = { q: '', tag: '', origin: '' };

  function setPressed(value: string) {
    for (const chip of document.querySelectorAll<HTMLElement>('[data-tag-filter]')) {
      chip.setAttribute('aria-pressed', String(chip.dataset.tagFilter === value));
    }
  }

  function setOriginPressed(value: string) {
    for (const chip of document.querySelectorAll<HTMLElement>('[data-origin-filter]')) {
      chip.setAttribute('aria-pressed', String(chip.dataset.originFilter === value));
    }
  }

  function matches(card: HTMLElement) {
    if (state.origin && card.dataset.origin !== state.origin) return false;
    if (state.tag && !(card.dataset.tags ?? '').split(',').includes(state.tag)) return false;
    if (state.q && !(card.dataset.search ?? '').includes(state.q)) return false;
    return true;
  }

  function apply(pushUrl = true) {
    let visible = 0;

    for (const card of cards) {
      const show = matches(card);
      (card.parentElement as HTMLElement).hidden = !show;
      if (show) visible++;
    }

    empty!.hidden = visible > 0;
    grid!.hidden = visible === 0;
    count!.textContent = `${visible} of ${cards.length} shown`;

    const filtered = Boolean(state.q) || Boolean(state.tag) || Boolean(state.origin);
    reset!.hidden = !filtered;

    if (pushUrl) {
      const params = new URLSearchParams();
      if (state.q) params.set('q', state.q);
      if (state.tag) params.set('tag', state.tag);
      if (state.origin) params.set('from', state.origin);
      const query = params.toString();
      history.replaceState(null, '', query ? `?${query}` : location.pathname);
    }
  }

  // Restore a shared/bookmarked filtered view.
  const params = new URLSearchParams(location.search);
  state.q = (params.get('q') ?? '').toLowerCase();
  state.tag = (params.get('tag') ?? '').toLowerCase();
  state.origin = ['library', 'external'].includes(params.get('from') ?? '') ? params.get('from')! : '';
  if (search) search.value = params.get('q') ?? '';
  setPressed(state.tag);
  setOriginPressed(state.origin);

  let timer: ReturnType<typeof setTimeout>;
  search?.addEventListener('input', () => {
    clearTimeout(timer);
    timer = setTimeout(() => {
      state.q = search.value.trim().toLowerCase();
      apply();
    }, 120);
  });

  document.addEventListener('click', (event) => {
    const origin = (event.target as HTMLElement)?.closest<HTMLElement>('[data-origin-filter]');
    if (origin) {
      state.origin = origin.dataset.originFilter ?? '';
      setOriginPressed(state.origin);
      apply();
      return;
    }

    const chip = (event.target as HTMLElement)?.closest<HTMLElement>('[data-tag-filter]');
    if (!chip) return;

    // Tag chips toggle, so clicking the active one clears it.
    state.tag = state.tag === chip.dataset.tagFilter ? '' : (chip.dataset.tagFilter ?? '');
    setPressed(state.tag);
    apply();
  });

  reset?.addEventListener('click', () => {
    state.q = '';
    state.tag = '';
    state.origin = '';
    if (search) search.value = '';
    setPressed('');
    setOriginPressed('');
    apply();
  });

  document.addEventListener('keydown', (event) => {
    const typingElsewhere = document.activeElement instanceof HTMLInputElement;
    if (event.key === '/' && !typingElsewhere) {
      event.preventDefault();
      search?.focus();
    }
    if (event.key === 'Escape' && document.activeElement === search) {
      search?.blur();
    }
  });

  apply(false);
</script>
