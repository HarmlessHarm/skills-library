---
import Base from '../../layouts/Base.astro';
import SkillDetail from '../../components/SkillDetail.astro';
import { getSkills } from '../../lib/items';

export async function getStaticPaths() {
  const skills = await getSkills();
  return skills.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}

const { item } = Astro.props;
---

<Base title={item.title} description={item.description}>
  <SkillDetail item={item} />
</Base>
